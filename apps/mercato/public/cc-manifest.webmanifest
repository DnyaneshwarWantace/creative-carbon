    { "name": "Orders", "short_name": "Orders", "url": "/backend/orders", "icons": [{ "src": "/cc-icon-192.png", "sizes": "192x192" }] },
    { "name": "Stock", "short_name": "Stock", "url": "/backend/stock", "icons": [{ "src": "/cc-icon-192.png", "sizes": "192x192" }] }
  ]
