# ==========================================
# Creative Carbon Composites ERP & CRM — Environment Config
# ==========================================

# PostgreSQL Database Configuration
# Update host, port, user, password, and database name for your server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=creative_carbon
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:change-me@localhost:5432/creative_carbon

# JWT & Auth Secrets — generate real random values before deploying, e.g.:
#   openssl rand -hex 32
# Never reuse the same value across environments.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
AUTH_SECRET=replace-with-a-random-32-plus-character-secret
NEXTAUTH_SECRET=

# Redis Transport
REDIS_URL=redis://localhost:6379

# Public Application URL
APP_URL=http://localhost:3000

# Onboarding & Demo Flags
DEMO_MODE=false
SELF_SERVICE_ONBOARDING_ENABLED=false

# Search Indexer (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=replace-with-your-meilisearch-master-key

# Tenant Data Encryption Key (AES-256-GCM fallback key for encrypted PII and fields)
# Generate with: openssl rand -base64 32
# WARNING: changing this after data has been encrypted makes that data unreadable.
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=replace-with-a-random-32-plus-character-key

# Feature Flags
OM_ENABLE_ENTERPRISE_MODULES=false
